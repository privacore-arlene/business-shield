# PrivaCore Business Fraud Check — client configuration.
#
# Copy to `.env.local` for local development and set the same values in
# Netlify → Site settings → Environment variables.
# NEVER commit a real `.env` file. Only VITE_* values belong here: they are
# public and ship in the browser bundle. Service-role keys, the Turnstile
# secret, and all provider API keys live ONLY in Supabase edge function
# secrets.

# Supabase project that hosts the check-business-fraud edge function.
VITE_PC_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_PC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Cloudflare Turnstile SITE key issued for check.privacoregroup.com.
# This must be a NEW site key, separate from any other property.
VITE_PC_TURNSTILE_SITE_KEY=0x0000000000000000000000